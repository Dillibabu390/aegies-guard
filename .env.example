# AegisGuard AI - Cloud Run & Production Environment Configuration

# Server Port (injected automatically by Google Cloud Run)
PORT=8080
HOST=0.0.0.0

# Google Gemini AI Key
# Powers Agent 2 (RAG), Agent 3 (Multimodal Biometrics), Agent 5 (Scam Coercion)
# If left blank, internal high-fidelity fallback engine executes with zero disruption
GEMINI_API_KEY=

# MongoDB Connection URI (e.g. MongoDB Atlas or Cloud MongoDB instance)
# Direct sub-millisecond retrieval of user profiles, graph topology, and audit logs
MONGO_URI=mongodb://localhost:27017/fraud_detection_db

# Spring Boot Monolith URL (Optional: if Spring Boot is deployed as a companion service)
# Non-blocking circuit breaker automatically operates safely if unreachable
SPRING_BOOT_URL=http://localhost:8080
